# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# On Vercel, set the same names per environment (Production / Preview).

# Neon Postgres connection string (pooled). Local + Preview: branch "dev". Production: branch "main".
DATABASE_URL=

# Random secret, at least 32 characters, different per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Public base URL of this deployment.
#   Local: http://localhost:3000 · Preview: the dev branch URL · Production: https://crossfit-box-timer.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Auth Platform → Clients → Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Extra emails allowed to sign in, comma-separated (the developer's own account).
# Only honoured outside production; never set it in Vercel Production.
AUTH_EXTRA_EMAILS=
